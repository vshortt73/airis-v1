[Unit]
Description=Iris Llama.cpp Server for Orpheus TTS
After=network.target
# This runs the Orpheus model on llama.cpp for token generation
# Orpheus server (iris-orpheus.service) depends on this

[Service]
Type=simple
User=captain
WorkingDirectory=/home/captain
Environment="CUDA_VISIBLE_DEVICES=1"
# Adjust model path and parameters as needed
ExecStart=/home/captain/llama.cpp/build/bin/llama-server \
    --model /models/audio/orpheus/orpheus-3b-0.1-ft-q4_k_m.gguf \
    --host 0.0.0.0 \
    --port 8080 \
    --ctx-size 4096 \
    --n-gpu-layers 99 \
    --flash-attn
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
