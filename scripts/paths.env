# Airis v1 — Client box path configuration
# Sourced by all Airis scripts
#
# The client box does NOT run its own inference server.
# Inference comes from the facility server (sglang on the network).

AIRIS_VENV="/venv/airis"
AIRIS_PROJECT_ROOT="/airis-v1"
AIRIS_EMBEDDING_MODEL="/models/llm_models/huggingface/models/all-mpnet-base-v2/"

# Facility inference server (sglang)
# Override with AIRIS_INFERENCE_URL env var or edit this line per deployment.
INFERENCE_URL="${AIRIS_INFERENCE_URL:-http://localhost:11434}"
