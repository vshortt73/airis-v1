# Shared path configuration — sourced by all localhost Iris scripts
# Edit this file to change paths for a different deployment
#
# These paths are also in the system_config database table (category: paths)
# for Python code access. Keep both in sync when changing deployments.

IRIS_VENV="/venv/iris-v3"
IRIS_PROJECT_ROOT="/iris-v3"
IRIS_LLAMA_SERVER="/programs/llama.cpp/build/bin/llama-server"

# Model files (localhost only — Node2 models managed by Node2 systemd units)
IRIS_MAIN_MODEL="/localmodels/qwen/Qwen3-32B-Q4_K_M.gguf"
IRIS_ALT_MODEL="/models/llm_models/qwen/Qwen3-30B-A3B-abliterated-erotic.Q5_K_M.gguf"
IRIS_EMBEDDING_MODEL="/models/llm_models/huggingface/models/all-mpnet-base-v2/"
